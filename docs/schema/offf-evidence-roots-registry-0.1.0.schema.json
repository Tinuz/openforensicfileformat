{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offf.dev/schema/offf-evidence-roots-registry-0.1.0.schema.json",
  "title": "OFFF Evidence Roots Registry v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "roots"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "case_id": { "type": "string", "minLength": 1 },
    "roots": {
      "type": "array",
      "items": { "$ref": "offf-root-descriptor-0.1.0.schema.json" }
    }
  }
}