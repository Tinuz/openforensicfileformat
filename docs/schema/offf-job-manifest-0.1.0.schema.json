{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offf.dev/schema/offf-job-manifest-0.1.0.schema.json",
  "title": "OFFF Job Manifest v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "created_at", "case_id", "task", "scope", "tool", "parameters"],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "case_id": {
      "type": "string",
      "pattern": "^urn:offf:case:.+$"
    },
    "task": {
      "type": "string",
      "enum": ["keyword_scan", "yara_scan"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunks"],
      "properties": {
        "chunks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|sha256:[0-9a-f]{64})$"
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "parameters": {
      "type": "object"
    }
  }
}