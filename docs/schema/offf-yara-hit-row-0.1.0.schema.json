{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offf.dev/schema/offf-yara-hit-row-0.1.0.schema.json",
  "title": "OFFF YARA Hit Row v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hit_id",
    "job_id",
    "rule_name",
    "ruleset_hash",
    "chunk_id",
    "physical_offset",
    "match_length",
    "file_id",
    "worker_id",
    "timestamp"
  ],
  "properties": {
    "hit_id": { "type": "string" },
    "job_id": { "type": "string" },
    "rule_name": { "type": "string" },
    "ruleset_hash": { "type": "string" },
    "chunk_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "physical_offset": { "type": "integer", "minimum": 0 },
    "match_length": { "type": "integer", "minimum": 0 },
    "file_id": { "type": "string" },
    "worker_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}