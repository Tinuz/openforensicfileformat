{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offf.dev/schema/offf-case-verify-report-0.1.0.schema.json",
  "title": "OFFF Case Verify Report v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "profile", "status", "root_summary", "object_summary", "checks", "warnings", "errors"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["valid", "warning", "invalid"] },
    "root_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "valid", "warning", "invalid", "missing", "offline"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "valid": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "offline": { "type": "integer", "minimum": 0 }
      }
    },
    "object_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_objects", "roots_referenced", "orphan_objects", "cross_root_relations"],
      "properties": {
        "total_objects": { "type": "integer", "minimum": 0 },
        "roots_referenced": { "type": "integer", "minimum": 0 },
        "orphan_objects": { "type": "integer", "minimum": 0 },
        "cross_root_relations": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "object" } },
    "errors": { "type": "array", "items": { "type": "object" } }
  }
}