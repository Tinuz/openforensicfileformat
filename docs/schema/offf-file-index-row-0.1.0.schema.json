{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offf.dev/schema/offf-file-index-row-0.1.0.schema.json",
  "title": "OFFF File Index Row v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file_id",
    "filesystem_id",
    "partition_id",
    "path",
    "filename",
    "extension",
    "size_bytes",
    "physical_extents",
    "chunk_refs",
    "is_directory",
    "is_deleted",
    "parser",
    "parser_version",
    "parser_status",
    "parser_error"
  ],
  "properties": {
    "file_id": { "type": "integer", "minimum": 0 },
    "filesystem_id": { "type": "string" },
    "partition_id": { "type": "string" },
    "path": { "type": "string" },
    "filename": { "type": "string" },
    "extension": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string" },
    "modified_at": { "type": "string" },
    "accessed_at": { "type": "string" },
    "changed_at": { "type": "string" },
    "physical_extents": { "type": "string" },
    "chunk_refs": { "type": "string" },
    "is_directory": { "type": "boolean" },
    "is_deleted": { "type": "boolean" },
    "parser": { "type": "string" },
    "parser_version": { "type": "string" },
    "parser_status": { "type": "string", "enum": ["ok", "partial", "error"] },
    "parser_error": { "type": "string" }
  }
}