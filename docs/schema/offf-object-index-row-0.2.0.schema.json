{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offf.dev/schema/offf-object-index-row-0.2.0.schema.json",
  "title": "OFFF Object Index Row v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "object_type",
    "name",
    "logical_path",
    "size_bytes",
    "source_layer",
    "content_ref",
    "parser_status",
    "schema_version"
  ],
  "properties": {
    "object_id": { "type": "string", "minLength": 1 },
    "object_type": { "type": "string", "minLength": 1 },
    "name": { "type": ["string", "null"] },
    "logical_path": { "type": ["string", "null"] },
    "media_type": { "type": ["string", "null"] },
    "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_layer": {
      "type": "string",
      "enum": ["evidence", "derived_object", "analysis", "collection"]
    },
    "content_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "filesystem_file",
            "filesystem",
            "evidence_object_store",
            "derived_object_store"
          ]
        },
        "filesystem_id": { "type": ["string", "null"] },
        "file_id": { "type": ["string", "null"] },
        "file_index_path": { "type": ["string", "null"] },
        "storage_ref": { "type": ["string", "null"] }
      }
    },
    "content_hash_status": {
      "type": ["string", "null"],
      "enum": ["verified", "deferred", "unavailable", "error", null]
    },
    "storage_ref": { "type": ["string", "null"] },
    "root_source_ref": { "type": ["string", "null"] },
    "root_id": { "type": ["string", "null"] },
    "collection_relative_path": { "type": ["string", "null"] },
    "created_by_job_id": { "type": ["string", "null"], "minLength": 1 },
    "parser_status": {
      "type": "string",
      "enum": ["success", "ok", "partial", "error", "unknown", "not_parsed", "not_applicable"]
    },
    "provenance_ref": { "type": ["string", "null"], "minLength": 1 },
    "schema_version": { "type": "string", "const": "0.2.0" },
    "original_created_at": { "type": ["string", "null"], "format": "date-time" },
    "original_modified_at": { "type": ["string", "null"], "format": "date-time" },
    "original_accessed_at": { "type": ["string", "null"], "format": "date-time" }
  }
}