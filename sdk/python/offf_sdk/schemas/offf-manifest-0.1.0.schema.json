{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offf.dev/schema/offf-manifest-0.1.0.schema.json",
  "title": "OFFF Manifest v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offf_version",
    "container_id",
    "created_at",
    "created_by_tool",
    "source",
    "hashes",
    "chunking",
    "indexes"
  ],
  "properties": {
    "offf_version": {
      "type": "string",
      "pattern": "^0\\.1\\.0$"
    },
    "container_id": {
      "type": "string",
      "pattern": "^urn:offf:case:.+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_tool": {
      "$ref": "#/$defs/toolInfo"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size_bytes", "sector_size"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["raw_image", "e01_image"]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sector_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "merkle_root_sha256"],
      "properties": {
        "source_sha256": {
          "$ref": "#/$defs/sha256Hex"
        },
        "merkle_root_sha256": {
          "$ref": "#/$defs/sha256Hex"
        }
      }
    },
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_size", "chunking_mode", "compression", "hash_algorithm"],
      "properties": {
        "chunk_size": {
          "type": "integer",
          "minimum": 1
        },
        "chunking_mode": {
          "type": "string",
          "enum": ["fixed"]
        },
        "compression": {
          "type": "string",
          "enum": ["none", "zstd"]
        },
        "hash_algorithm": {
          "type": "string",
          "enum": ["sha256"]
        }
      }
    },
    "indexes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_to_chunk"],
      "properties": {
        "physical_to_chunk": {
          "type": "string",
          "const": "maps/physical_to_chunk.parquet"
        }
      }
    }
  },
  "$defs": {
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
