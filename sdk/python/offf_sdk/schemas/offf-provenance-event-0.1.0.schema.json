{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offf.dev/schema/offf-provenance-event-0.1.0.schema.json",
  "title": "OFFF Provenance Event v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "timestamp", "actor", "action", "tool", "details"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9]{6}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "details": {
      "type": "object"
    }
  }
}
